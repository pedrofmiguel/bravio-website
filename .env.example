# --------------------------------------------------------------------------
# Contact form delivery
#
# The enquiry form posts to /api/contact, which sends through Gmail SMTP.
# Gmail rejects a plain account password here: you need an App Password,
# which requires 2-Step Verification to be on for the account.
#
#   1. Google Account > Security > turn on 2-Step Verification
#   2. Google Account > Security > App passwords > create one for "Mail"
#   3. Paste the 16 character value into GMAIL_APP_PASSWORD (spaces are fine)
#
# On Vercel these go in Project Settings > Environment Variables. Add them to
# Production and Preview both, or previews will return a 500 on submit.
# --------------------------------------------------------------------------

GMAIL_USER=hello@bravio.pt
GMAIL_APP_PASSWORD=

# Where enquiries land. Defaults to GMAIL_USER when unset.
CONTACT_TO=hello@bravio.pt

# Set to 1 to accept and log submissions without sending anything. Useful for
# local work and preview deploys. Leave unset in production.
CONTACT_DRY_RUN=

# --------------------------------------------------------------------------
# Spam protection
#
# BotID needs no keys. It works automatically on Vercel deployments; locally
# checkBotId() cannot reach Vercel to validate, so the route logs a warning and
# lets the request through (see the fail-open note in the route).
#
# Protected paths are listed in src/instrumentation-client.ts and must match
# the routes that call checkBotId(), or real submissions get rejected.
#
# Also worth turning on once, in the Vercel dashboard:
#   Firewall > Rules > Bot Protection managed ruleset (free)
# --------------------------------------------------------------------------
